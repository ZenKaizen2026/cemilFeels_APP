<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_mood_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:fontFamily="sans-serif-black"
        android:text="Pilih Mood Kamu"
        android:textColor="#212121"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
        android:id="@+id/sv_mood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tv_mood_label"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="12dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHappy"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="Happy"
                android:textColor="@color/mood_chip_text_color"
                android:textSize="14sp"
                app:chipBackgroundColor="@drawable/bg_mood_chip_selector"
                app:chipCornerRadius="24dp"
                app:chipIcon="@drawable/hpy"
                app:chipIconSize="28dp"
                app:chipIconVisible="true"
                app:chipStrokeWidth="0dp"
                app:iconStartPadding="12dp"
                app:rippleColor="@color/mood_chip_ripple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSad"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="Sad"
                android:textColor="@color/mood_chip_text_color"
                android:textSize="14sp"
                app:chipBackgroundColor="@drawable/bg_mood_chip_selector"
                app:chipCornerRadius="24dp"
                app:chipIcon="@drawable/sad"
                app:chipIconSize="28dp"
                app:chipIconVisible="true"
                app:chipStrokeWidth="0dp"
                app:iconStartPadding="12dp"
                app:rippleColor="@color/mood_chip_ripple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAngry"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="Angry"
                android:textColor="@color/mood_chip_text_color"
                android:textSize="14sp"
                app:chipBackgroundColor="@drawable/bg_mood_chip_selector"
                app:chipCornerRadius="24dp"
                app:chipIcon="@drawable/mad"
                app:chipIconSize="28dp"
                app:chipIconVisible="true"
                app:chipStrokeWidth="0dp"
                app:iconStartPadding="12dp"
                app:rippleColor="@color/mood_chip_ripple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBored"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="Bored"
                android:textColor="@color/mood_chip_text_color"
                android:textSize="14sp"
                app:chipBackgroundColor="@drawable/bg_mood_chip_selector"
                app:chipCornerRadius="24dp"
                app:chipIcon="@drawable/brng"
                app:chipIconSize="28dp"
                app:chipIconVisible="true"
                app:chipStrokeWidth="0dp"
                app:iconStartPadding="12dp"
                app:rippleColor="@color/mood_chip_ripple" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>