<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/colorPrimary"
    app:strokeWidth="1.5dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rincian Transaksi"
            android:textColor="@color/colorTextDark"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Close Button (X) -->
        <ImageButton
            android:id="@+id/btn_close_detail"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/colorTextDark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Tutup" />

        <View
            android:id="@+id/divider_detail_top"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorGrayLight"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_title" />

        <!-- Status -->
        <TextView
            android:id="@+id/tv_lbl_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Status"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_detail_top" />

        <TextView
            android:id="@+id/tv_val_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selesai"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lbl_status"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lbl_status" />

        <!-- Payment Method -->
        <TextView
            android:id="@+id/tv_lbl_pay_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Metode Pembayaran"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_status" />

        <TextView
            android:id="@+id/tv_val_pay_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shopee Pay"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lbl_pay_method"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lbl_pay_method" />

        <!-- Waktu -->
        <TextView
            android:id="@+id/tv_lbl_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Waktu"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_pay_method" />

        <TextView
            android:id="@+id/tv_val_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18:00"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lbl_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lbl_time" />

        <!-- Tanggal -->
        <TextView
            android:id="@+id/tv_lbl_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tanggal"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_time" />

        <TextView
            android:id="@+id/tv_val_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 Juni 2026"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lbl_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lbl_date" />

        <!-- Nama Toko -->
        <TextView
            android:id="@+id/tv_lbl_store"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nama Toko"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_date" />

        <TextView
            android:id="@+id/tv_val_store"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CemilJog"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lbl_store"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lbl_store" />

        <!-- QTY -->
        <TextView
            android:id="@+id/tv_lbl_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="QTY"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_store" />

        <TextView
            android:id="@+id/tv_val_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 (100gr)"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lbl_qty"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lbl_qty" />

        <!-- Cemilan -->
        <TextView
            android:id="@+id/tv_lbl_snack_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cemilan"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_qty" />

        <TextView
            android:id="@+id/tv_val_snack_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Basreng Stik"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lbl_snack_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lbl_snack_name" />

        <!-- Alamat -->
        <TextView
            android:id="@+id/tv_lbl_detail_addr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Alamat"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_snack_name" />

        <TextView
            android:id="@+id/tv_val_detail_addr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ConCat"
            android:textColor="@color/colorTextDark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lbl_detail_addr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lbl_detail_addr" />

        <View
            android:id="@+id/divider_detail_bottom"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="@color/colorPrimary"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_detail_addr" />

        <!-- Total Transaksi -->
        <TextView
            android:id="@+id/tv_lbl_trans_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Total Transaksi"
            android:textColor="@color/colorTextDark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_detail_bottom" />

        <TextView
            android:id="@+id/tv_val_trans_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp. 23.000"
            android:textColor="@color/colorAccent"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lbl_trans_total"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lbl_trans_total" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
