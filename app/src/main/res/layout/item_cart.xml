<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/colorGrayLight"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_cart_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/basreng_stik"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="Gambar Camilan" />

        <TextView
            android:id="@+id/tv_cart_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Basreng Stik"
            android:textColor="@color/colorTextDark"
            android:textStyle="bold"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@id/iv_cart_image"
            app:layout_constraintEnd_toStartOf="@id/btn_cart_remove"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_cart_remove"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/colorAccent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Hapus Item" />

        <TextView
            android:id="@+id/tv_cart_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="Pedasnya basreng nagih, instan usir..."
            android:textColor="@android:color/darker_gray"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/iv_cart_image"
            app:layout_constraintEnd_toStartOf="@id/layout_cart_counter"
            app:layout_constraintTop_toBottomOf="@id/tv_cart_name" />

        <TextView
            android:id="@+id/tv_cart_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:text="Rp. 16.000"
            android:textColor="@color/colorPrimaryDark"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/iv_cart_image"
            app:layout_constraintTop_toBottomOf="@id/tv_cart_desc" />

        <!-- Quantity Counter controls -->
        <LinearLayout
            android:id="@+id/layout_cart_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_cart_minus"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="-"
                android:padding="0dp"
                android:textSize="12sp"
                android:textColor="@color/colorTextDark" />

            <TextView
                android:id="@+id/tv_cart_qty"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:gravity="center"
                android:textColor="@color/colorTextDark"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_cart_plus"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="+"
                android:padding="0dp"
                android:textSize="12sp"
                android:textColor="@color/colorTextDark" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
