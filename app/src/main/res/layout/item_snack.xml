<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="160dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#EAEAEA"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- 1. Gambar Camilan -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_snack_img"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iv_snack_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/basreng_stik"
                tools:ignore="ContentDescription" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Nama Camilan -->
        <TextView
            android:id="@+id/tv_snack_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Basreng Stik"
            android:textColor="#212121"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/layout_rating"
            app:layout_constraintStart_toEndOf="@id/card_snack_img"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Rating Row -->
        <LinearLayout
            android:id="@+id/layout_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_snack_name">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                app:srcCompat="@drawable/ic_star"
                app:tint="#FFC107"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_snack_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="4.5"
                android:textColor="#757575"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Deskripsi -->
        <TextView
            android:id="@+id/tv_snack_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Pedasnya basreng nagih, instan usir bad mood dan bikin happy!"
            android:textColor="#757575"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_snack_img"
            app:layout_constraintTop_toBottomOf="@id/tv_snack_name" />

        <!-- Selected Label (Hidden by default) -->
        <TextView
            android:id="@+id/tv_selected_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dipilih"
            android:textColor="#FF7A1A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_add_snack"
            app:layout_constraintEnd_toStartOf="@id/btn_add_snack"
            app:layout_constraintTop_toTopOf="@id/btn_add_snack" />

        <!-- 2. Harga -->
        <TextView
            android:id="@+id/tv_snack_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Rp. 16.000"
            android:textColor="#FF7A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_snack_img" />

        <!-- 2. Tombol Tambah -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_snack"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:backgroundTint="#FF7A1A"
            app:rippleColor="#80FFFFFF"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_plus"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
