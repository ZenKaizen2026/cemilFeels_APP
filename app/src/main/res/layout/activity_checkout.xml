<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5">

    <!-- 1. App Bar Modern -->
    <include
        android:id="@+id/layout_checkout_header"
        layout="@layout/layout_checkout_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_checkout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PREMIUM SEGMENTED CONTROL -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/segmented_container"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_segmented_container"
                android:padding="4dp">

                <View
                    android:id="@+id/view_indicator"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_segmented_indicator"
                    android:elevation="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <TextView
                    android:id="@+id/tv_toggle_delivery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:fontFamily="sans-serif-medium"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Delivery"
                    android:textColor="#FF7A1A"
                    android:textSize="14sp"
                    android:translationZ="5dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_center"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_toggle_pickup"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:fontFamily="sans-serif-medium"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Pick Up"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:translationZ="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline_center" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- CARD ALAMAT (DELIVERY) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/iv_address_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:srcCompat="@drawable/logo_checkout_delivery"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_address_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Alamat Pengiriman"
                        android:textColor="#212121"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@id/iv_address_icon"
                        app:layout_constraintTop_toTopOf="@id/iv_address_icon"
                        app:layout_constraintBottom_toBottomOf="@id/iv_address_icon" />

                    <TextView
                        android:id="@+id/tv_address_details"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="Jl. Bantul raya adoh kono, mwuah cerak goa"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="3dp"
                        app:layout_constraintStart_toStartOf="@id/tv_address_label"
                        app:layout_constraintEnd_toStartOf="@id/btn_change_address"
                        app:layout_constraintTop_toBottomOf="@id/tv_address_label" />

                    <!-- MODERN ACTION BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_change_address"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_button_outlined_pill"
                        android:text="Ubah"
                        android:textAllCaps="false"
                        android:textColor="#FF7A1A"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_location_pin_sophisticated"
                        app:iconSize="16dp"
                        app:iconPadding="4dp"
                        app:iconTint="#FF7A1A"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD RESTO (PICKUP) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pickup_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/iv_store_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:srcCompat="@drawable/logo_checkout_restaurant"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_store_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Lokasi Pengambilan"
                        android:textColor="#212121"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@id/iv_store_icon"
                        app:layout_constraintTop_toTopOf="@id/iv_store_icon"
                        app:layout_constraintBottom_toBottomOf="@id/iv_store_icon" />

                    <TextView
                        android:id="@+id/tv_store_details"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Cemil Feels Resto\nJl. Merdeka No. 45, Yogyakarta"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        app:layout_constraintStart_toStartOf="@id/tv_store_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_store_label" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD ESTIMASI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/iv_delivery_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:srcCompat="@drawable/logo_checkout_time"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_delivery_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Estimasi Tiba"
                        android:textColor="#212121"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@id/iv_delivery_icon"
                        app:layout_constraintTop_toTopOf="@id/iv_delivery_icon"
                        app:layout_constraintBottom_toTopOf="@id/badge_eta" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badge_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#FFF2E8"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="@id/tv_delivery_label"
                        app:layout_constraintTop_toBottomOf="@id/tv_delivery_label">

                        <TextView
                            android:id="@+id/tv_delivery_eta"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="12dp"
                            android:text="20 - 30 menit"
                            android:textColor="#FF7A1A"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:drawablePadding="6dp"
                            app:drawableStartCompat="@drawable/ic_access_time_sophisticated"
                            app:drawableTint="#FF7A1A" />
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RINGKASAN PESANAN -->
            <include
                android:id="@+id/layout_order_summary"
                layout="@layout/layout_checkout_order_summary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. Bottom Sticky Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_payment"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:backgroundTint="#FF7A1A"
            android:text="Pilih Metode Pembayaran"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-bold"
            android:layout_margin="8dp"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_wallet_sophisticated"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>