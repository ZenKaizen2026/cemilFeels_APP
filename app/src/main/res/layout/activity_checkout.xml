<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5">

    <!-- 1. App Bar Modern dengan Subtitle -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_checkout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:background="#FFF9F5"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_checkout_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="#212121"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_checkout_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_checkout_back"
            app:layout_constraintTop_toTopOf="@id/btn_checkout_back">

            <TextView
                android:id="@+id/tv_checkout_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checkout Pesanan"
                android:textColor="#212121"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pastikan semua informasi pesanan sudah benar."
                android:textColor="#757575"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_checkout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- OPSI PENGIRIMAN: Pick Up / Delivery -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_delivery_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="true"
                app:checkedButton="@id/btn_delivery"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delivery"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delivery"
                    android:textColor="#FF7A1A"
                    app:strokeColor="#FF7A1A"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pickup"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pick Up"
                    android:textColor="#757575"
                    app:strokeColor="#E0E0E0"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- KARTU 1A: Alamat Pengiriman (Delivery) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp">

                    <ImageView
                        android:id="@+id/iv_address_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_location_on"
                        app:tint="#FF7A1A"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:contentDescription="Ikon Alamat" />

                    <TextView
                        android:id="@+id/tv_address_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Alamat Pengiriman"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@id/iv_address_icon"
                        app:layout_constraintTop_toTopOf="@id/iv_address_icon"
                        app:layout_constraintBottom_toBottomOf="@id/iv_address_icon"/>

                    <TextView
                        android:id="@+id/tv_address_details"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="12dp"
                        android:text="Jl. Bantul raya adoh kono, mwuah cerak goa"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="4dp"
                        app:layout_constraintStart_toEndOf="@id/iv_address_icon"
                        app:layout_constraintEnd_toStartOf="@id/btn_change_address"
                        app:layout_constraintTop_toBottomOf="@id/tv_address_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_change_address"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Ubah"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FF7A1A"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconTint="#FF7A1A"
                        app:iconGravity="end"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTU 1B: Lokasi Resto (Pick Up) - Awalnya Sembunyi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pickup_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp">

                    <ImageView
                        android:id="@+id/iv_store_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_location_on"
                        app:tint="#FF7A1A"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:contentDescription="Ikon Resto" />

                    <TextView
                        android:id="@+id/tv_store_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Lokasi Pengambilan (Resto)"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@id/iv_store_icon"
                        app:layout_constraintTop_toTopOf="@id/iv_store_icon"
                        app:layout_constraintBottom_toBottomOf="@id/iv_store_icon"/>

                    <TextView
                        android:id="@+id/tv_store_details"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="12dp"
                        android:text="Cemil Feels Resto\nJl. Merdeka No. 45, Kota Yogyakarta"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="4dp"
                        app:layout_constraintStart_toEndOf="@id/iv_store_icon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_store_label" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTU 2: Estimasi Pengiriman / Waktu Ambil -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp">

                    <ImageView
                        android:id="@+id/iv_delivery_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_local_shipping"
                        app:tint="#FF7A1A"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:contentDescription="Ikon Estimasi" />

                    <TextView
                        android:id="@+id/tv_delivery_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Estimasi Tiba"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@id/iv_delivery_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/badge_eta"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <!-- Badge Wrapper agar bentuknya Pill/Rounded -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badge_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginStart="12dp"
                        app:cardBackgroundColor="#FFF2E8"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:layout_constraintStart_toEndOf="@id/iv_delivery_icon"
                        app:layout_constraintTop_toBottomOf="@id/tv_delivery_label"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/tv_delivery_eta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Akan sampai 20 - 30 menit"
                            android:textColor="#FF7A1A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:drawablePadding="6dp"
                            app:drawableStartCompat="@drawable/ic_access_time"
                            app:drawableTint="#FF7A1A" />
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTU 3: Ringkasan Pesanan & Biaya -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ringkasan Pesanan"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Container for dynamic items -->
                    <LinearLayout
                        android:id="@+id/layout_order_items_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="16dp" />

                    <!-- Subtotal Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textColor="#757575"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tv_checkout_subtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 36.000"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Ongkos Kirim -->
                    <LinearLayout
                        android:id="@+id/layout_delivery_fee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ongkos Kirim"
                            android:textColor="#757575"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 5.000"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Biaya Layanan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Biaya Layanan"
                            android:textColor="#757575"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 2.000"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="16dp" />

                    <!-- Total Biaya (Fokus Utama) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Pembayaran"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_wallet"
                            app:drawableTint="#FF7A1A"
                            android:drawablePadding="8dp"/>

                        <TextView
                            android:id="@+id/tv_checkout_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 43.000"
                            android:textColor="#FF7A1A"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. Bottom Sticky Bar: Metode Pembayaran (Elevated Floating Card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <!-- Tombol CTA Utama -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_payment"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#FF7A1A"
                android:text="Pilih Metode Pembayaran"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_wallet"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
