<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- ================================================= -->
    <!-- BRAND SIGNATURE                                   -->
    <!-- ================================================= -->


    <!-- ================================================= -->
    <!-- HERO VISUAL                                       -->
    <!-- ================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_hero_visual"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_content">

        <!-- Background Halo -->
        <View
            android:id="@+id/view_hero_halo"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="@drawable/bg_welcome_hero_halo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- ================================================= -->
        <!-- MAIN MASCOT                                       -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="90dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="28dp"
                android:src="@drawable/emot_home" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- FEELING HAPPY CARD                                -->
        <!-- POSISI TIDAK DIUBAH                               -->
        <!-- ================================================= -->


        <!-- ================================================= -->
        <!-- SNACK MATCH CARD                                  -->
        <!-- POSISI VISUAL DIPERTAHANKAN                       -->
        <!-- Menggunakan REAL CONSTRAINT, bukan tools:absolute -->
        <!-- ================================================= -->


        <!-- ================================================= -->
        <!-- DECORATIVE STAR                                   -->
        <!-- Mengikuti Snack Match secara aman                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/card_mood_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-24dp"
            android:layout_marginBottom="72dp"
            android:background="@drawable/bg_welcome_mini_card"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.323"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hpy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/welcome_feeling_happy"
                android:textColor="@color/colorTextDark"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_snack_match"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginBottom="228dp"
            android:background="@drawable/bg_welcome_mini_card"
            android:elevation="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.755"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Snack Image -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/basreng_stik" />

            </com.google.android.material.card.MaterialCardView>


            <!-- Snack Information -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/welcome_snack_match"
                    android:textAllCaps="true"
                    android:textColor="@color/colorActive"
                    android:textSize="10sp"
                    tools:ignore="SmallSp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/welcome_perfect_match"
                    android:textColor="@color/colorTextDark"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_snack_match_star"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="34dp"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_star"
            app:layout_constraintBottom_toTopOf="@id/card_snack_match"
            app:layout_constraintEnd_toEndOf="@id/card_snack_match"
            app:tint="#FFD54F" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ================================================= -->
    <!-- CONTENT GUIDELINE                                 -->
    <!-- ================================================= -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.55" />


    <!-- ================================================= -->
    <!-- TYPOGRAPHY SECTION                                -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/layout_welcome_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/guideline_content">

        <!-- Headline -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="-2dp"
            android:text="@string/welcome_title"
            android:textColor="@color/colorTextDark"
            android:textSize="30sp"
            android:textStyle="bold" />


        <!-- Description -->
        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/welcome_description"
            android:textColor="@color/textSecondary"
            android:textSize="15sp" />


        <!-- Mood-Aware Badge -->
        <LinearLayout
            android:id="@+id/layoutFeature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_rounded_rectangle_19"
            android:backgroundTint="#FFF0E5"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_star"
                app:tint="@color/colorActive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Mood-aware recommendations"
                android:textColor="@color/colorActive"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- GET STARTED BUTTON                                -->
    <!-- ================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorActive"
        app:cornerRadius="16dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/txtVersion" />


    <!-- ================================================= -->
    <!-- VERSION                                           -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/txtVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Version 2.0"
        android:textColor="@color/colorTextGrey"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ================================================= -->
    <!-- COMPATIBILITY PLACEHOLDER                         -->
    <!-- ================================================= -->

    <View
        android:id="@+id/txtSubtitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>