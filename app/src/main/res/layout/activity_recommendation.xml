<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Top Navigation -->
        <ImageButton
            android:id="@+id/btn_rec_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/colorPrimaryDark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_cart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Keranjang Belanja"
            app:srcCompat="@drawable/ic_cart"
            app:tint="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Titles -->
        <TextView
            android:id="@+id/tv_rec_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Rekomendasi Camilan Sesuai\nIsi Hatimu"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/btn_rec_back" />

        <TextView
            android:id="@+id/tv_rec_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pilih camilan yang pas untuk mengembalikan suasana perasaanmu"
            android:textColor="@color/colorTextDark"
            android:textSize="12sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tv_rec_title" />

        <!-- Carousel ViewPager2 for Snack Cards -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_snacks_carousel"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tv_rec_subtitle" />

        <!-- Carousel Dot Indicators -->
        <LinearLayout
            android:id="@+id/layout_dots_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vp_snacks_carousel">
            <!-- Dynamic dot views will be added here programmatically, or simple template views -->
            <View
                android:layout_width="24dp"
                android:layout_height="6dp"
                android:layout_margin="3dp"
                android:background="@drawable/btn_pill"
                android:backgroundTint="@color/colorPrimary" />
            <View
                android:layout_width="12dp"
                android:layout_height="6dp"
                android:layout_margin="3dp"
                android:background="@drawable/btn_pill"
                android:backgroundTint="@color/colorGrayLight" />
            <View
                android:layout_width="12dp"
                android:layout_height="6dp"
                android:layout_margin="3dp"
                android:background="@drawable/btn_pill"
                android:backgroundTint="@color/colorGrayLight" />
        </LinearLayout>

        <!-- Atur Level Kepedasan Section -->
        <TextView
            android:id="@+id/tv_spice_level_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Atur Level kepedasan"
            android:textColor="@color/colorTextDark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_dots_indicator" />

        <!-- Spice Selector Grid (Tidak Pedas, Sedang, Pedas, Extra Pedas) -->
        <LinearLayout
            android:id="@+id/layout_spice_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="4"
            app:layout_constraintTop_toBottomOf="@id/tv_spice_level_title">

            <!-- Tidak Pedas -->
            <LinearLayout
                android:id="@+id/btn_spice_none"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:padding="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_rounded_rectangle_19"
                android:backgroundTint="@color/white"
                android:elevation="1dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_chili"
                    app:tint="@color/colorTextDark" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tidak Pedas"
                    android:textSize="9sp"
                    android:textColor="@color/colorTextDark"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Sedang -->
            <LinearLayout
                android:id="@+id/btn_spice_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:padding="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_rounded_rectangle_19"
                android:backgroundTint="@color/white"
                android:elevation="1dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_chili"
                    app:tint="@color/colorAccent" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sedang"
                    android:textSize="9sp"
                    android:textColor="@color/colorTextDark"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Pedas -->
            <LinearLayout
                android:id="@+id/btn_spice_high"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:padding="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_rounded_rectangle_19"
                android:backgroundTint="@color/colorPrimary"
                android:elevation="1dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_chili"
                        app:tint="@color/white" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_chili"
                        app:tint="@color/white" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedas"
                    android:textSize="9sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Extra Pedas -->
            <LinearLayout
                android:id="@+id/btn_spice_extra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:padding="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_rounded_rectangle_19"
                android:backgroundTint="@color/white"
                android:elevation="1dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        app:srcCompat="@drawable/ic_chili"
                        app:tint="@color/colorAccent" />
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        app:srcCompat="@drawable/ic_chili"
                        app:tint="@color/colorAccent" />
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        app:srcCompat="@drawable/ic_chili"
                        app:tint="@color/colorAccent" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extra Pedas"
                    android:textSize="9sp"
                    android:textColor="@color/colorTextDark"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Seller Note Section -->
        <TextView
            android:id="@+id/tv_seller_note_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Catatann untuk penjual ( Opsional )"
            android:textColor="@color/colorTextDark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_spice_selector" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_seller_note"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/colorSelected"
            app:layout_constraintTop_toBottomOf="@id/tv_seller_note_title">

            <EditText
                android:id="@+id/et_seller_note"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="Contoh: Tanpa gula, tanpa cabe, tanpa kecap dsb"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/colorPrimaryDark"
                android:textColorHint="@color/colorPrimary"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Order Button (Pesan) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pesan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/colorPrimary"
            android:text="Pesan"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/card_seller_note"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
