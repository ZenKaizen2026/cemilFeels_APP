<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_checkout_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:background="#FFF9F5"
    android:elevation="0dp">

    <ImageButton
        android:id="@+id/btn_checkout_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Kembali"
        app:srcCompat="@drawable/ic_arrow_back"
        app:tint="#212121"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_checkout_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_checkout_back"
        app:layout_constraintTop_toTopOf="@id/btn_checkout_back">

        <TextView
            android:id="@+id/tv_checkout_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checkout Pesanan"
            android:textColor="#212121"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pastikan semua informasi sudah benar"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>