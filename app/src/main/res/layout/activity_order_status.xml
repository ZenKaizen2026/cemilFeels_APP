<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Header Navigation -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_status_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_status_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_rounded_rectangle_19"
            android:backgroundTint="#FFFFFF"
            android:elevation="2dp"
            android:contentDescription="Back"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="#212121"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track Order"
            android:textColor="#212121"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/layout_status_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Hero Progress Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F0F0F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp">

                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginBottom="20dp">
                        <View
                            android:id="@+id/view_hero_pulse"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_status_dot_current"
                            android:alpha="0.2"/>
                        <ImageView
                            android:id="@+id/iv_hero_status"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            android:src="@drawable/emot_home"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_chef_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memasak Camilanmu..."
                        android:textColor="#212121"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Driver akan menjemput setelah matang"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:gravity="center"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order ID Card (Premium) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/iv_order_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_receipt"
                        app:tint="#FF7A1A"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@id/iv_order_icon"
                        app:layout_constraintEnd_toStartOf="@id/btn_copy_order_id"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Order Reference"
                            android:textColor="#757575"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tv_order_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#CML-2024-8822"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_order_id"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SALIN"
                        android:textColor="#FF7A1A"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Custom Timeline Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="32dp">

                <!-- Timeline Lines -->
                <View
                    android:id="@+id/line_inactive"
                    android:layout_width="3dp"
                    android:layout_height="0dp"
                    android:background="#E0E0E0"
                    app:layout_constraintStart_toStartOf="@id/dot_received"
                    app:layout_constraintEnd_toEndOf="@id/dot_received"
                    app:layout_constraintTop_toTopOf="@id/dot_received"
                    app:layout_constraintBottom_toBottomOf="@id/dot_arrived"/>

                <View
                    android:id="@+id/view_vertical_line_active"
                    android:layout_width="3dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_status_line_gradient"
                    app:layout_constraintStart_toStartOf="@id/dot_received"
                    app:layout_constraintEnd_toEndOf="@id/dot_received"
                    app:layout_constraintTop_toTopOf="@id/dot_received"
                    app:layout_constraintBottom_toTopOf="@id/dot_preparing"/>

                <!-- Node 1: Received -->
                <ImageView
                    android:id="@+id/dot_received"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/bg_status_dot_completed"
                    android:elevation="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <LinearLayout
                    android:id="@+id/container_received"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp"
                    app:layout_constraintStart_toEndOf="@id/dot_received"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dot_received">

                    <TextView
                        android:id="@+id/tv_lbl_received"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Confirmed"
                        android:textColor="#2E7D32"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_time_received"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14:20"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Node 2: Preparing -->
                <ImageView
                    android:id="@+id/dot_preparing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="56dp"
                    android:src="@drawable/bg_status_dot_current"
                    android:elevation="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dot_received"/>

                <LinearLayout
                    android:id="@+id/container_preparing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp"
                    app:layout_constraintStart_toEndOf="@id/dot_preparing"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dot_preparing">

                    <TextView
                        android:id="@+id/tv_lbl_preparing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chef is Preparing"
                        android:textColor="#FF7A1A"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_time_preparing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14:25"
                        android:textColor="#FF7A1A"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Node 3: Shipping -->
                <ImageView
                    android:id="@+id/dot_shipping"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="56dp"
                    android:src="@drawable/ic_circle_outline"
                    app:tint="#E0E0E0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dot_preparing"/>

                <LinearLayout
                    android:id="@+id/container_shipping"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp"
                    app:layout_constraintStart_toEndOf="@id/dot_shipping"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dot_shipping">

                    <TextView
                        android:id="@+id/tv_lbl_shipping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Out for Delivery"
                        android:textColor="#9E9E9E"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_time_shipping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Node 4: Arrived -->
                <ImageView
                    android:id="@+id/dot_arrived"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="56dp"
                    android:src="@drawable/ic_circle_outline"
                    app:tint="#E0E0E0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dot_shipping"/>

                <LinearLayout
                    android:id="@+id/container_arrived"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp"
                    app:layout_constraintStart_toEndOf="@id/dot_arrived"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dot_arrived">

                    <TextView
                        android:id="@+id/tv_lbl_arrived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enjoy your snacks!"
                        android:textColor="#9E9E9E"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_time_arrived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimating..."
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:paddingBottom="40dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_status_detail"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Receipt"
                    app:cornerRadius="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Help Center"
                    android:backgroundTint="#212121"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom ETA Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_eta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#212121"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iv_timer"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_access_time"
                app:tint="#FF7A1A"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tv_eta_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Estimated Delivery Time"
                android:textColor="#BDBDBD"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/iv_timer"
                app:layout_constraintTop_toTopOf="@id/iv_timer"
                app:layout_constraintBottom_toBottomOf="@id/iv_timer"/>

            <TextView
                android:id="@+id/tv_eta_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:55"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_timer"/>

            <TextView
                android:id="@+id/tv_eta_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arriving in 15 mins"
                android:textColor="#FF7A1A"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_rounded_rectangle_19"
                android:backgroundTint="#33FF7A1A"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/tv_eta_time"
                app:layout_constraintTop_toTopOf="@id/tv_eta_time"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
