<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5">

    <!-- 1. Header Navigation Premium -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_status_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:background="#FFF9F5"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_status_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="#212121"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_status_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_status_back"
            app:layout_constraintTop_toTopOf="@id/btn_status_back">

            <TextView
                android:id="@+id/tv_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Order Status"
                android:textColor="#212121"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pantau pesananmu secara real-time."
                android:textColor="#757575"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. Scrollable Center Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="130dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_status_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Status Card (Fokus Utama) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_illustration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="32dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:src="@drawable/emot_home"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/tv_chef_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pesanan Sedang Disiapkan 🍳"
                        android:textColor="#FF7A1A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tim kami sedang menyiapkan camilan favoritmu dengan penuh perhatian."
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:textAlignment="center"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order ID Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_order_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_receipt"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/ic_receipt"
                        app:tint="#FF7A1A"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        app:layout_constraintStart_toEndOf="@id/iv_receipt"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/tv_order_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Order ID"
                            android:textColor="#757575"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_order_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#CML088228642625"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_copy_order_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SALIN"
                        android:textColor="#FF7A1A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_rounded_rectangle_19"
                        android:backgroundTint="#FFF2E8"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Pembayaran (Tambahan UI Premium) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/ic_wallet"
                        app:tint="#2E7D32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Metode Pembayaran"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✔ Berhasil"
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_rounded_rectangle_19"
                        android:backgroundTint="#E8F5E9"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Timeline Tracking Frame -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="28dp">

                    <!-- Vertical Lines -->
                    <View
                        android:id="@+id/view_vertical_line_bg"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:background="#EEEEEE"
                        app:layout_constraintBottom_toBottomOf="@id/dot_arrived"
                        app:layout_constraintEnd_toEndOf="@id/dot_received"
                        app:layout_constraintStart_toStartOf="@id/dot_received"
                        app:layout_constraintTop_toTopOf="@id/dot_received" />

                    <View
                        android:id="@+id/view_vertical_line_active"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:background="#FF7A1A"
                        app:layout_constraintEnd_toEndOf="@id/dot_received"
                        app:layout_constraintStart_toStartOf="@id/dot_received"
                        app:layout_constraintTop_toTopOf="@id/dot_received"
                        app:layout_constraintBottom_toTopOf="@id/dot_preparing"/>

                    <!-- Node 1: Received (Selesai - Hijau) -->
                    <View
                        android:id="@+id/dot_received"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_rounded_rectangle_19"
                        android:backgroundTint="#2E7D32"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_lbl_received"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Pesanan Diterima"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_receipt"
                        app:drawableTint="#2E7D32"
                        android:drawablePadding="8dp"
                        app:layout_constraintBottom_toBottomOf="@id/dot_received"
                        app:layout_constraintStart_toEndOf="@id/dot_received"
                        app:layout_constraintTop_toTopOf="@id/dot_received" />

                    <TextView
                        android:id="@+id/tv_time_received"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18:00"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/dot_received"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/dot_received" />

                    <!-- Node 2: Preparing (Aktif - Orange) -->
                    <View
                        android:id="@+id/dot_preparing"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="40dp"
                        android:background="@drawable/bg_rounded_rectangle_19"
                        android:backgroundTint="#FF7A1A"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/dot_received" />

                    <TextView
                        android:id="@+id/tv_lbl_preparing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Sedang Disiapkan"
                        android:textColor="#FF7A1A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_restaurant"
                        app:drawableTint="#FF7A1A"
                        android:drawablePadding="8dp"
                        app:layout_constraintBottom_toBottomOf="@id/dot_preparing"
                        app:layout_constraintStart_toEndOf="@id/dot_preparing"
                        app:layout_constraintTop_toTopOf="@id/dot_preparing" />

                    <TextView
                        android:id="@+id/tv_time_preparing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18:05"
                        android:textColor="#FF7A1A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/dot_preparing"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/dot_preparing" />

                    <!-- Node 3: Shipping (Belum - Abu) -->
                    <View
                        android:id="@+id/dot_shipping"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="40dp"
                        android:background="@drawable/bg_rounded_rectangle_19"
                        android:backgroundTint="#EEEEEE"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/dot_preparing" />

                    <TextView
                        android:id="@+id/tv_lbl_shipping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Sedang Dikirim"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/ic_local_shipping"
                        app:drawableTint="#9E9E9E"
                        android:drawablePadding="8dp"
                        app:layout_constraintBottom_toBottomOf="@id/dot_shipping"
                        app:layout_constraintStart_toEndOf="@id/dot_shipping"
                        app:layout_constraintTop_toTopOf="@id/dot_shipping" />

                    <TextView
                        android:id="@+id/tv_time_shipping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/dot_shipping"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/dot_shipping" />

                    <!-- Node 4: Arrived (Belum - Abu) -->
                    <View
                        android:id="@+id/dot_arrived"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="40dp"
                        android:background="@drawable/bg_rounded_rectangle_19"
                        android:backgroundTint="#EEEEEE"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/dot_shipping" />

                    <TextView
                        android:id="@+id/tv_lbl_arrived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Pesanan Tiba"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/ic_location_on"
                        app:drawableTint="#9E9E9E"
                        android:drawablePadding="8dp"
                        app:layout_constraintBottom_toBottomOf="@id/dot_arrived"
                        app:layout_constraintStart_toEndOf="@id/dot_arrived"
                        app:layout_constraintTop_toTopOf="@id/dot_arrived" />

                    <TextView
                        android:id="@+id/tv_time_arrived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/dot_arrived"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/dot_arrived" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CTA Opsional (Modern Buttons) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Detail"
                    android:textColor="#FF7A1A"
                    android:textStyle="bold"
                    app:backgroundTint="#FFF2E8"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_receipt"
                    app:iconTint="#FF7A1A"
                    app:iconGravity="textStart"
                    app:elevation="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Hubungi"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="#FF7A1A"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_chat"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:elevation="2dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. Sticky Bottom Bar: ETA Card Premium -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_eta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp">

            <ImageView
                android:id="@+id/iv_eta_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/ic_access_time"
                app:tint="#FF7A1A"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@id/iv_eta_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_eta_countdown">

                <TextView
                    android:id="@+id/tv_eta_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimasi Tiba"
                    android:textColor="#757575"
                    android:textSize="13sp" />

                <!-- Meskipun ID tv_eta_time digunakan, tampilannya dibuat modern -->
                <TextView
                    android:id="@+id/tv_eta_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18 Menit Lagi"
                    android:textColor="#212121"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Menjaga ID tv_eta_countdown agar tidak error di Kotlin -->
            <TextView
                android:id="@+id/tv_eta_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tepat Waktu"
                android:textColor="#FF7A1A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_rectangle_19"
                android:backgroundTint="#FFF2E8"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>