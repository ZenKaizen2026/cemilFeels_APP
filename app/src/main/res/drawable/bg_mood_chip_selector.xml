<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mood_chip_selected_bg" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="@color/mood_chip_selected_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mood_chip_unselected_bg" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/mood_chip_unselected_stroke" />
        </shape>
    </item>
</selector>